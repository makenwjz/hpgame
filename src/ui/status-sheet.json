{
  "kind": "正文美化",
  "preset": "gilded",
  "root": "content",
  "floors": 10,
  "statusHead": {
    "kind": "状态栏",
    "form": "header",
    "preset": "gilded",
    "title": "哈莉·波特·行间",
    "collapsed": true,
    "summary": [
      { "path": "/时空/日期", "label": "日期", "kind": "文本" },
      { "path": "/时空/时段", "label": "时段", "kind": "枚举", "values": ["上午", "下午", "黄昏", "夜晚"] },
      { "path": "/日程/本周已用", "label": "行动", "kind": "数值", "range": [0, 4] },
      { "path": "/主角/学院分", "label": "学院分", "kind": "数值", "range": [-200, 500] }
    ],
    "pages": [
      {
        "name": "主角",
        "icon": "heart",
        "blocks": [
          {
            "type": "stats",
            "title": "档案",
            "items": [
              { "path": "/主角/姓名", "label": "姓名", "kind": "文本" },
              { "path": "/主角/学院", "label": "学院", "kind": "枚举", "values": ["格兰芬多", "斯莱特林", "拉文克劳", "赫奇帕奇", "未分院"] },
              { "path": "/时空/学年", "label": "学年", "kind": "数值", "range": [1, 7] },
              { "path": "/主角/年级", "label": "年级", "kind": "数值", "range": [1, 7] },
              { "path": "/主角/血统", "label": "血统", "kind": "枚举", "values": ["纯血", "混血", "麻瓜出身", "未知"] },
              { "path": "/主角/出身", "label": "出身", "kind": "文本" },
              { "path": "/主角/魔杖/木材", "label": "魔杖木材", "kind": "文本" },
              { "path": "/主角/魔杖/杖芯", "label": "杖芯", "kind": "文本" },
              { "path": "/主角/学院分", "label": "学院分", "kind": "数值", "range": [-200, 500] },
              { "path": "/物品与金钱/钱/加隆", "label": "加隆", "kind": "数值" }
            ]
          },
          {
            "type": "bars",
            "title": "体力与魔力",
            "items": [
              { "path": "/主角/体力", "label": "体力", "kind": "数值", "range": [0, 100] },
              { "path": "/主角/魔力", "label": "魔力", "kind": "数值", "range": [0, 100] },
              { "path": "/主角/伤势", "label": "伤势", "kind": "数值", "range": [0, 100] }
            ]
          }
        ]
      },
      {
        "name": "五维",
        "icon": "star",
        "blocks": [
          {
            "type": "levels",
            "title": "学业（阶 + 经验）",
            "columns": 1,
            "tiers": [
              { "name": "生手", "upTo": 1 },
              { "name": "跟得上", "upTo": 2 },
              { "name": "拿得出手", "upTo": 3 },
              { "name": "尖子", "upTo": 4 },
              { "name": "博识", "upTo": 5 }
            ],
            "items": [{ "path": "/五维/学业/阶", "label": "学业", "kind": "数值", "range": [1, 5] }]
          },
          {
            "type": "levels",
            "title": "胆识",
            "columns": 1,
            "tiers": [
              { "name": "怯", "upTo": 1 },
              { "name": "稳", "upTo": 2 },
              { "name": "敢", "upTo": 3 },
              { "name": "狠", "upTo": 4 },
              { "name": "无畏", "upTo": 5 }
            ],
            "items": [{ "path": "/五维/胆识/阶", "label": "胆识", "kind": "数值", "range": [1, 5] }]
          },
          {
            "type": "levels",
            "title": "魅力",
            "columns": 1,
            "tiers": [
              { "name": "素", "upTo": 1 },
              { "name": "清秀", "upTo": 2 },
              { "name": "引人", "upTo": 3 },
              { "name": "出众", "upTo": 4 },
              { "name": "摄人", "upTo": 5 }
            ],
            "items": [{ "path": "/五维/魅力/阶", "label": "魅力", "kind": "数值", "range": [1, 5] }]
          },
          {
            "type": "levels",
            "title": "共情",
            "columns": 1,
            "tiers": [
              { "name": "钝", "upTo": 1 },
              { "name": "客气", "upTo": 2 },
              { "name": "会听", "upTo": 3 },
              { "name": "接得住", "upTo": 4 },
              { "name": "通透", "upTo": 5 }
            ],
            "items": [{ "path": "/五维/共情/阶", "label": "共情", "kind": "数值", "range": [1, 5] }]
          },
          {
            "type": "levels",
            "title": "心志",
            "columns": 1,
            "tiers": [
              { "name": "软", "upTo": 1 },
              { "name": "撑得住", "upTo": 2 },
              { "name": "扛得住", "upTo": 3 },
              { "name": "立得住", "upTo": 4 },
              { "name": "不动", "upTo": 5 }
            ],
            "items": [{ "path": "/五维/心志/阶", "label": "心志", "kind": "数值", "range": [1, 5] }]
          },
          {
            "type": "bars",
            "title": "本阶经验（满 6 升阶）",
            "items": [
              { "path": "/五维/学业/经验", "label": "学业", "kind": "数值", "range": [0, 6] },
              { "path": "/五维/胆识/经验", "label": "胆识", "kind": "数值", "range": [0, 6] },
              { "path": "/五维/魅力/经验", "label": "魅力", "kind": "数值", "range": [0, 6] },
              { "path": "/五维/共情/经验", "label": "共情", "kind": "数值", "range": [0, 6] },
              { "path": "/五维/心志/经验", "label": "心志", "kind": "数值", "range": [0, 6] }
            ]
          },
          {
            "type": "bars",
            "title": "本学年已得（上限 12）",
            "items": [
              { "path": "/五维/学业/本年已得", "label": "学业", "kind": "数值", "range": [0, 12] },
              { "path": "/五维/胆识/本年已得", "label": "胆识", "kind": "数值", "range": [0, 12] },
              { "path": "/五维/魅力/本年已得", "label": "魅力", "kind": "数值", "range": [0, 12] },
              { "path": "/五维/共情/本年已得", "label": "共情", "kind": "数值", "range": [0, 12] },
              { "path": "/五维/心志/本年已得", "label": "心志", "kind": "数值", "range": [0, 12] }
            ]
          }
        ]
      },
      {
        "name": "日程",
        "icon": "clock",
        "blocks": [
          {
            "type": "stats",
            "title": "此刻",
            "items": [
              { "path": "/时空/日期", "label": "日期", "kind": "文本" },
              { "path": "/时空/时段", "label": "时段", "kind": "枚举", "values": ["上午", "下午", "黄昏", "夜晚"] },
              { "path": "/时空/周", "label": "第几周", "kind": "数值", "range": [1, 43] }
            ]
          },
          {
            "type": "bars",
            "title": "本周行动点",
            "items": [
              { "path": "/日程/本周已用", "label": "已用", "kind": "数值", "range": [0, 4] },
              { "path": "/日程/行动点上限", "label": "上限", "kind": "数值", "range": [0, 4] }
            ]
          },
          { "type": "tags", "title": "本周安排", "path": "/日程/本周安排", "kind": "列表" },
          { "type": "text", "title": "当前事件", "path": "/事件线索/当前事件", "kind": "文本" },
          { "type": "tags", "title": "进行中的支线", "path": "/事件线索/进行中支线", "kind": "列表" },
          {
            "type": "fold",
            "title": "期限",
            "open": true,
            "blocks": [
              {
                "type": "relation",
                "path": "/期限",
                "hideEmpty": true,
                "fields": {
                  "截止周": "/期限/{键}/截止周",
                  "状态": "/期限/{键}/状态",
                  "后果": "/期限/{键}/后果等级"
                }
              }
            ]
          }
        ]
      },
      {
        "name": "关系",
        "icon": "users",
        "blocks": [
          {
            "type": "roster",
            "title": "人物与社群（点名字展开）",
            "path": "/关系",
            "hideEmpty": true,
            "gate": "/关系/{键}/Rank",
            "gateAt": 1,
            "fields": {
              "身份": "/关系/{键}/身份",
              "年龄": "/关系/{键}/年龄",
              "印象": "/关系/{键}/印象",
              "服饰": "/关系/{键}/服饰",
              "支线": "/关系/{键}/支线状态",
              "任务": "/关系/{键}/当前任务"
            },
            "gated": {
              "身高": "/关系/{键}/身高",
              "体重": "/关系/{键}/体重",
              "三围": "/关系/{键}/三围",
              "体型": "/关系/{键}/体型",
              "名器评级": "/关系/{键}/名器评级",
              "名器": "/关系/{键}/名器"
            },
            "bar": "/关系/{键}/Rank",
            "barRange": [1, 10]
          }
        ]
      },
      {
        "name": "网",
        "icon": "pin",
        "blocks": [
          {
            "type": "relation",
            "title": "关系网（只显示变过的边）",
            "path": "/网",
            "hideEmpty": true,
            "fields": {
              "状态": "/网/{键}/状态",
              "强度": "/网/{键}/强度"
            },
            "bar": "/网/{键}/强度",
            "barRange": [1, 5]
          }
        ]
      },
      {
        "name": "塔罗",
        "icon": "scroll",
        "blocks": [
          {
            "type": "text",
            "title": "说明",
            "text": "22 张塔罗是可操作角色；在「关系」页按 Rank 与门槛查看谁已入队。",
            "kind": "文本"
          },
          {
            "type": "roster",
            "title": "已入队（Rank ≥ 3 的人）",
            "path": "/关系",
            "hideEmpty": true,
            "gate": "/关系/{键}/Rank",
            "gateAt": 3,
            "fields": {
              "身份": "/关系/{键}/身份",
              "印象": "/关系/{键}/印象"
            },
            "bar": "/关系/{键}/Rank",
            "barRange": [1, 10]
          }
        ]
      },
      {
        "name": "宫殿",
        "icon": "map",
        "blocks": [
          {
            "type": "stats",
            "title": "宫殿",
            "items": [
              { "path": "/宫殿/当前", "label": "宫殿", "kind": "文本" },
              { "path": "/宫殿/层", "label": "层", "kind": "数值", "range": [0, 5] },
              { "path": "/宫殿/位置/x", "label": "坐标 X", "kind": "数值" },
              { "path": "/宫殿/位置/y", "label": "坐标 Y", "kind": "数值" }
            ]
          },
          {
            "type": "bars",
            "title": "资源",
            "items": [
              { "path": "/宫殿/灯火", "label": "灯火", "kind": "数值", "range": [0, 300] },
              { "path": "/宫殿/警戒", "label": "警戒", "kind": "数值", "range": [0, 100] },
              { "path": "/宫殿/钥匙", "label": "钥匙", "kind": "数值", "range": [0, 9] },
              { "path": "/宫殿/意志", "label": "意志", "kind": "数值", "range": [0, 9] }
            ]
          },
          { "type": "tags", "title": "碎片（3 块开门）", "path": "/宫殿/碎片", "kind": "列表" },
          { "type": "tags", "title": "本局战利品", "path": "/宫殿/本局战利品", "kind": "列表" },
          {
            "type": "stats",
            "title": "改心进度",
            "items": [
              { "path": "/宫殿/退路", "label": "退路", "kind": "数值", "range": [0, 2] }
            ]
          }
        ]
      }
    ],
    "cardName": "哈莉·波特·行间"
  },
  "modules": [
    { "tag": "story", "role": "章节" },
    { "tag": "time", "role": "页眉" },
    { "tag": "now_plot", "role": "正文" },
    { "tag": "scene", "role": "场景" },
    { "tag": "ability", "role": "提示" },
    { "tag": "check", "role": "检定" },
    { "tag": "event", "role": "折叠", "label": "特殊事件" },
    { "tag": "inner", "role": "独白" }
  ],
